# Copy to .env and fill in.
GRAFANA_ADMIN_PASSWORD=change-me
# 127.0.0.1 keeps Grafana local; set 0.0.0.0 to reach it from the LAN.
GRAFANA_BIND=127.0.0.1

# Telegram: create a bot with @BotFather, then get your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional local LLM hint on each alert (Ollama). Leave empty to disable.
OLLAMA_URL=
OLLAMA_MODEL=llama3.2:3b
